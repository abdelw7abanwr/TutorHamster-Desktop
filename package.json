{
  "name": "tutorhamster-desktop",
  "version": "1.0.0",
  "description": "TutorHamster Desktop App",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "build:icons": "node scripts/convert-icons.js"
  },
  "repository": "https://github.com/abdelw7abanwr/TutorHamster-Desktop",
  "build": {
    "appId": "com.tutorhamster.desktop",
    "productName": "TutorHamster",
    "win": {
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "icon": "assets/icons/logo-v1-drop-rounded.png"
    },
    "linux": {
      "icon": "assets/icons/logo-v1-drop-rounded.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abdelw7abanwr",
        "repo": "TutorHamster-Desktop"
      }
    ]
  },
  "keywords": [
    "Electron",
    "quick",
    "start",
    "tutorial",
    "demo"
  ],
  "author": "GitHub",
  "license": "CC0-1.0",
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.1.0",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
